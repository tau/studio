---
import SiteLayout from '@/layouts/SiteLayout.astro';
import Button from '@/components/shared/Button.astro';
import ClosingCta from '@/components/shared/ClosingCta.astro';
import { services } from '@/data/services';

const serviceList = {
  '@type': 'ItemList',
  name: 'Servicios de Tau Studio',
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Service',
      name: service.title,
      description: service.description,
      url: `https://tau.studio/servicios/${service.slug}`,
      provider: { '@id': 'https://tau.studio#organization' },
    },
  })),
};
---

<SiteLayout
  title="Servicios | Tau Studio"
  description="Diseño web, desarrollo, marketing digital y SEO para marcas que quieren crecer."
  image="/og-servicios.png"
  schemaType="CollectionPage"
  mainEntity={serviceList}
  themeColor="#6853A2"
>
  <main class="content services-page">
    <header class="services-page__intro">
      <div>
        <p class="services-page__eyebrow"><span></span> Servicios <b>/ 01</b></p>
        <h1>Ideas claras.<br /><em>Soluciones digitales.</em></h1>
      </div>
      <div class="services-page__summary">
        <p>Unimos estrategia, diseño y tecnología para resolver retos reales y ayudar a tu marca a avanzar.</p>
        <Button href="/contacto" label="Hablemos de tu proyecto" />
      </div>
    </header>

    <section class="services-page__grid" aria-label="Nuestros servicios">
      {services.map((service) => (
        <article class={`services-page__card ${service.className}`}>
          <a class="services-page__card-content" href={`/servicios/${service.slug}`} aria-label={`Ver detalle de ${service.title}`}>
            <div class="services-page__card-top">
              <span>{service.number}</span>
              <span class="services-page__card-link" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </div>
            <h2>{service.title}</h2>
            <p>{service.description}</p>
            <div class="services-page__detail">{service.detail}</div>
          </a>
        </article>
      ))}
    </section>

    <section class="services-process" aria-labelledby="services-process-title">
      <div class="services-process__intro">
        <div>
          <p class="services-process__eyebrow"><span></span> El proceso <b>/ 02</b></p>
          <h2 id="services-process-title">Cómo <em>trabajamos.</em></h2>
        </div>
        <p>Un proceso claro y colaborativo, adaptado a lo que necesita cada proyecto.</p>
      </div>

      <ol class="services-process__steps">
        <li>
          <span class="services-process__number">01</span>
          <h3>Escuchamos</h3>
          <p>Entendemos tu negocio, tus objetivos y el reto que quieres resolver.</p>
        </li>
        <li>
          <span class="services-process__number">02</span>
          <h3>Definimos</h3>
          <p>Acordamos prioridades, alcance y una dirección estratégica para avanzar.</p>
        </li>
        <li>
          <span class="services-process__number">03</span>
          <h3>Diseñamos y construimos</h3>
          <p>Convertimos la estrategia en una solución digital cuidada y funcional.</p>
        </li>
        <li>
          <span class="services-process__number">04</span>
          <h3>Mejoramos</h3>
          <p>Revisamos resultados y buscamos oportunidades para seguir creciendo.</p>
        </li>
      </ol>
    </section>

    <ClosingCta
      variant="services"
      prompt="¿No sabes por dónde empezar?"
      emphasis="Cuéntanos el reto."
      ariaLabel="Contacta con Tau Studio"
    />
  </main>
</SiteLayout>
