---
import SiteLayout from '@/layouts/SiteLayout.astro';
import ClosingCta from '@/components/shared/ClosingCta.astro';
import { services } from '@/data/services';
---

<SiteLayout
  title="Servicios | Tau Studio"
  description="Diseño web, desarrollo, marketing digital y SEO para marcas que quieren crecer."
>
  <main class="content services-page">
    <header class="services-page__intro">
      <div>
        <p class="services-page__eyebrow"><span></span> Servicios <b>/ 01</b></p>
        <h1>Ideas claras.<br /><em>Soluciones digitales.</em></h1>
      </div>
      <div class="services-page__summary">
        <p>Unimos estrategia, diseño y tecnología para resolver retos reales y ayudar a tu marca a avanzar.</p>
        <a href="/contacto">
          <span>Hablemos de tu proyecto</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </header>

    <section class="services-page__grid" aria-label="Nuestros servicios">
      {services.map((service) => (
        <article class={`services-page__card ${service.className}`}>
          <a class="services-page__card-content" href={`/servicios/${service.slug}`} aria-label={`Ver detalle de ${service.title}`}>
            <div class="services-page__card-top">
              <span>{service.number}</span>
              <span class="services-page__card-link" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </div>
            <h2>{service.title}</h2>
            <p>{service.description}</p>
            <div class="services-page__detail">{service.detail}</div>
          </a>
        </article>
      ))}
    </section>

    <ClosingCta
      variant="services"
      prompt="¿No sabes por dónde empezar?"
      emphasis="Cuéntanos el reto."
      ariaLabel="Contacta con Tau Studio"
    />
  </main>
</SiteLayout>
