---
import SiteLayout from '@/layouts/SiteLayout.astro';
---

<SiteLayout
  robots="noindex,follow"
  title="Página no encontrada | Tau Studio"
  description="No encontramos la página que buscas. Vuelve al inicio o descubre los servicios de Tau Studio."
>
  <main class="content not-found">
    <section class="not-found__copy" aria-labelledby="not-found-title">
      <p class="not-found__eyebrow"><span></span>Error <b>/ 404</b></p>
      <h1 id="not-found-title">Esta página <em>no aparece.</em></h1>
      <p class="not-found__lead">Puede que el enlace haya cambiado o que la dirección no sea correcta. Vamos a buscar otro camino.</p>
      <div class="not-found__actions">
        <a class="not-found__primary" href="/">
          <span>Volver al inicio</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="not-found__secondary" href="/servicios">Ver servicios</a>
      </div>
    </section>

    <div class="not-found__visual" aria-hidden="true">
      <span class="not-found__visual-label">PÁGINA NO ENCONTRADA</span>
      <span class="not-found__visual-number">404</span>
      <i class="not-found__mark not-found__mark--purple"></i>
      <i class="not-found__mark not-found__mark--yellow"></i>
      <i class="not-found__mark not-found__mark--green"></i>
    </div>
  </main>
</SiteLayout>
