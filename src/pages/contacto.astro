---
import SiteLayout from '@/layouts/SiteLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
import { getMessages } from '@/i18n/messages';
import { asLocale, type Locale } from '@/i18n/routing';

interface Props { locale?: Locale }
const locale = asLocale(Astro.props.locale ?? Astro.currentLocale ?? undefined);
const messages = getMessages(locale);
---

<SiteLayout title={`${messages.navigation.contact} | Tau Studio`} description={messages.contact.metaDescription} image={`/og/${locale}/contact.png`} schemaType="ContactPage" mainEntity={{ '@id': 'https://tau.studio#organization' }} themeColor="#FBAF18" locale={locale}>
  <main id="main" tabindex="-1" class="content contact-page">
    <section class="contact-page__intro" aria-labelledby="contact-title">
      <p class="contact-page__eyebrow"><span></span>{messages.contact.eyebrow} <b>/</b> 04</p>
      <h1 id="contact-title">{messages.contact.title} <em>{messages.contact.titleAccent}</em></h1>
      <p class="contact-page__lead">{messages.contact.lead}</p>

      <div class="contact-page__details">
        <a href="mailto:hey@tau.studio">
          <span class="contact-page__detail-label">{messages.contact.writeUs}</span>
          <strong>hey@tau.studio</strong>
        </a>
      </div>
    </section>

    <section class="contact-page__panel" aria-labelledby="contact-form-title">
      <div class="contact-page__panel-heading">
        <div>
            <p class="contact-page__eyebrow">{messages.contact.tellIdea}</p>
            <h2 id="contact-form-title">{messages.contact.startHere}</h2>
        </div>
        <span class="contact-page__panel-index" aria-hidden="true">01—05</span>
      </div>
      <ContactForm locale={locale} />
    </section>
  </main>
</SiteLayout>
