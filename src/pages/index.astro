---
import SiteLayout from '@/layouts/SiteLayout.astro';
import Header from '@/components/shared/Header.astro';
import Clients from '@/components/shared/Clients.astro';
import FeaturedProjects from '@/components/shared/FeaturedProjects.astro';
import { clients } from '@/data/clients';
import { projects } from '@/data/projects';
import { testimonials } from '@/data/testimonials';
import { getMessages } from '@/i18n/messages';
import { asLocale, type Locale } from '@/i18n/routing';

interface Props { locale?: Locale }
const locale = asLocale(Astro.props.locale ?? Astro.currentLocale ?? undefined);
const messages = getMessages(locale);

const clientProjects = projects.filter((project) => project.category === 'client');
const clientProjectCount = clientProjects.length;
const uniqueClientCount = new Set(
  clientProjects
    .map((project) => project.clientGroup ?? project.slug),
).size;
---

<SiteLayout title={messages.home.metaTitle} description={messages.home.metaDescription} image={`/og/${locale}/home.png`} schemaType="WebPage" mainEntity={{ '@id': 'https://tau.studio#organization' }} randomizeAccents locale={locale}>
  <main id="main" tabindex="-1">
  <Header locale={locale} />
  <Clients clients={clients} max={clients.length} total={uniqueClientCount} projectTotal={clientProjectCount} testimonials={testimonials} locale={locale} />
  <FeaturedProjects locale={locale} />
  </main>
</SiteLayout>
