---
import ServicePage from '@/pages/servicios/[slug].astro';
import { getLocalizedServices } from '@/data/services-i18n';

export function getStaticPaths() {
  return getLocalizedServices('fr').map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
---

<ServicePage locale="fr" service={Astro.props.service} />
