---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { projects } from '@/data/projects';

const personalProjects = projects.filter((project) => project.category === 'personal');
const clientProjects = projects.filter((project) => project.category === 'client');
const activeProjects = personalProjects.filter((project) => project.status === 'active');
const archivedProjects = personalProjects.filter((project) => project.status === 'archived');

const groupByYear = (items) => {
  const years = [...new Set(items.map((project) => project.year))].sort((a, b) => b - a);
  return years.map((year) => ({
    year,
    projects: items.filter((project) => project.year === year),
  }));
};

const activeByYear = groupByYear(activeProjects);
const archivedByYear = groupByYear(archivedProjects);
const clientsByYear = groupByYear(clientProjects);
const projectUrl = (slug) => `https://qu4k3.com/proyecto/${slug}`;
---

<SiteLayout
  robots="noindex,follow"
  title="Proyectos | Tau Studio"
  description="Proyectos personales y colaboraciones con clientes de Paul Guillamón y Tau Studio."
>
  <main class="content projects-page">
    <header class="projects-page__intro">
      <div>
        <p class="projects-page__eyebrow"><span></span> Proyectos <b>/ 02</b></p>
        <h1>Ideas que toman <em>forma digital.</em></h1>
      </div>
      <div class="projects-page__summary">
        <p>Un recorrido por proyectos personales y trabajos realizados junto a clientes, desde productos digitales hasta sitios web corporativos.</p>
        <div class="projects-page__counts" aria-label="Resumen del catálogo">
          <span><strong>{personalProjects.length}</strong> personales</span>
          <span><strong>{clientProjects.length}</strong> para clientes</span>
        </div>
      </div>
    </header>

    <section class="projects-page__section" aria-labelledby="personal-projects-title">
      <div class="projects-page__section-heading">
        <p class="projects-page__eyebrow"><span></span> 01 <b>/</b> Proyectos personales</p>
        <h2 id="personal-projects-title">Ideas propias, en evolución.</h2>
      </div>

      <div class="projects-page__status-heading">
        <h3>Activos</h3>
        <span>{activeProjects.length} proyectos</span>
      </div>
      <div class="projects-page__years">
        {activeByYear.map((group) => (
          <section class="projects-page__year" aria-label={`Proyectos personales de ${group.year}`}>
            <h4>{group.year}</h4>
            <ul>
              {group.projects.map((project) => (
                <li>
                  <a href={projectUrl(project.slug)} target="_blank" rel="noopener noreferrer">
                    <span>{project.title}</span>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <details class="projects-page__archive">
        <summary>
          <span>Proyectos archivados</span>
          <span>{archivedProjects.length} proyectos</span>
        </summary>
        <div class="projects-page__years">
          {archivedByYear.map((group) => (
            <section class="projects-page__year" aria-label={`Proyectos personales archivados de ${group.year}`}>
              <h4>{group.year}</h4>
              <ul>
                {group.projects.map((project) => (
                  <li>
                    <a href={projectUrl(project.slug)} target="_blank" rel="noopener noreferrer">
                      <span>{project.title}</span>
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </details>
    </section>

    <section class="projects-page__section projects-page__clients" aria-labelledby="client-projects-title">
      <div class="projects-page__section-heading">
        <p class="projects-page__eyebrow"><span></span> 02 <b>/</b> Proyectos para clientes</p>
        <h2 id="client-projects-title">Trabajo compartido, resultados reales.</h2>
      </div>
      <div class="projects-page__years">
        {clientsByYear.map((group) => (
          <section class="projects-page__year" aria-label={`Proyectos para clientes de ${group.year}`}>
            <h4>{group.year}</h4>
            <ul>
              {group.projects.map((project) => (
                <li>
                  <a href={projectUrl(project.slug)} target="_blank" rel="noopener noreferrer">
                    <span>{project.title}</span>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>

    <div class="projects-page__closing">
      <p>¿Tienes un proyecto en mente? <span>Hablemos.</span></p>
      <a href="/contacto" aria-label="Hablar con Tau Studio sobre un proyecto">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </main>
</SiteLayout>
