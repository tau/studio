---
import SiteLayout from '@/layouts/SiteLayout.astro';
import ClosingCta from '@/components/shared/ClosingCta.astro';
import { projects } from '@/data/projects';
import { getMessages } from '@/i18n/messages';
import { asLocale, localizedPagePath, type Locale } from '@/i18n/routing';

interface Props { locale?: Locale }
const locale = asLocale(Astro.props.locale ?? Astro.currentLocale ?? undefined);
const messages = getMessages(locale);
const localizedStatus = (label: string) => ({
  Activo: messages.projects.active,
  Archivado: messages.projects.statusArchived,
  'En Desarrollo': messages.projects.inDevelopment,
  Finalizado: messages.projects.completed,
  Abandonado: messages.projects.abandoned,
}[label] ?? label);

const personalProjects = projects.filter((project) => project.category === 'personal');
const clientProjects = projects.filter((project) => project.category === 'client');
const otherProjects = projects.filter((project) => project.category === 'other');
const activeProjects = personalProjects.filter((project) => project.status === 'active');
const archivedProjects = personalProjects.filter((project) => project.status === 'archived');

const groupByYear = (items) => {
  const years = [...new Set(items.map((project) => project.year))].sort((a, b) => b - a);
  return years.map((year) => ({
    year,
    projects: items.filter((project) => project.year === year),
  }));
};

const activeByYear = groupByYear(activeProjects);
const archivedByYear = groupByYear(archivedProjects);
const clientsByYear = groupByYear(clientProjects);
const otherByYear = groupByYear(otherProjects);

const projectList = {
  '@type': 'ItemList',
  name: `${messages.projects.eyebrow} Tau Studio`,
  numberOfItems: projects.length,
  itemListElement: projects.map((project, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'CreativeWork',
      name: project.title,
      url: project.sourceUrl,
    },
  })),
};
---

<SiteLayout
  title={`${messages.navigation.projects} | Tau Studio`}
  description={messages.projects.pageLead}
  image={`/og/${locale}/projects.png`}
  schemaType="CollectionPage"
  mainEntity={projectList}
  themeColor="#EC1978"
  locale={locale}
>
  <main id="main" tabindex="-1" class="content projects-page">
    <header class="projects-page__intro">
      <div>
        <p class="projects-page__eyebrow"><span></span> {messages.projects.pageEyebrow} <b>/ 02</b></p>
        <h1>{messages.projects.pageTitle} <em>{messages.projects.pageTitleAccent}</em></h1>
      </div>
      <div class="projects-page__summary">
        <p>{messages.projects.pageLead}</p>
        <div class="projects-page__counts" aria-label={messages.projects.catalogAria}>
          <span><strong>{personalProjects.length}</strong> {messages.projects.personalCountLabel}</span>
          <span><strong>{clientProjects.length}</strong> {messages.projects.clientCountLabel}</span>
          <span><strong>{otherProjects.length}</strong> {messages.projects.otherCountLabel}</span>
        </div>
      </div>
    </header>

    <section class="projects-page__section" aria-labelledby="personal-projects-title">
      <div class="projects-page__section-heading">
        <p class="projects-page__eyebrow"><span></span> 01 <b>/</b> {messages.projects.personalHeading}</p>
        <h2 id="personal-projects-title">{messages.projects.personalIdeasTitle}</h2>
      </div>

      <div class="projects-page__status-heading">
        <h3>{messages.projects.active}</h3>
        <span>{activeProjects.length} {messages.projects.countLabel}</span>
      </div>
      <div class="projects-page__years">
        {activeByYear.map((group) => (
          <section class="projects-page__year" aria-label={`${messages.projects.activeProjectsAria} ${group.year}`}>
            <h4>{group.year}</h4>
            <ul>
              {group.projects.map((project) => (
                <li>
                  <a href={project.sourceUrl} target="_blank" rel="noopener noreferrer">
                    <span class="projects-page__name">{project.title}</span>
                    <span class={`projects-page__status projects-page__status--${project.status}`}>{localizedStatus(project.statusLabel)}</span>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <details class="projects-page__archive">
        <summary>
          <span>{messages.projects.archived}</span>
          <span>{archivedProjects.length} {messages.projects.countLabel}</span>
        </summary>
        <div class="projects-page__years">
          {archivedByYear.map((group) => (
            <section class="projects-page__year" aria-label={`${messages.projects.archivedProjectsAria} ${group.year}`}>
              <h4>{group.year}</h4>
              <ul>
                {group.projects.map((project) => (
                  <li>
                    <a href={project.sourceUrl} target="_blank" rel="noopener noreferrer">
                      <span class="projects-page__name">{project.title}</span>
                      <span class={`projects-page__status projects-page__status--${project.status}`}>{localizedStatus(project.statusLabel)}</span>
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </details>
    </section>

    <section class="projects-page__section projects-page__clients" aria-labelledby="client-projects-title">
      <div class="projects-page__section-heading">
        <p class="projects-page__eyebrow"><span></span> 02 <b>/</b> {messages.projects.clientHeading}</p>
        <h2 id="client-projects-title">{messages.projects.sharedWorkTitle}</h2>
      </div>
      <div class="projects-page__years">
        {clientsByYear.map((group) => (
          <section class="projects-page__year" aria-label={`${messages.projects.clientProjectsAria} ${group.year}`}>
            <h4>{group.year}</h4>
            <ul>
              {group.projects.map((project) => (
                <li>
                  <a href={project.sourceUrl} target="_blank" rel="noopener noreferrer">
                    <span class="projects-page__name">{project.title}</span>
                    <span class={`projects-page__status projects-page__status--${project.status}`}>{localizedStatus(project.statusLabel)}</span>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>

    {otherProjects.length > 0 && (
    <section class="projects-page__section projects-page__other" aria-labelledby="other-projects-title">
      <div class="projects-page__section-heading">
        <p class="projects-page__eyebrow"><span></span> 03 <b>/</b> {messages.projects.otherHeading}</p>
        <h2 id="other-projects-title">{messages.projects.experimentsTitle}</h2>
      </div>
      <div class="projects-page__years">
        {otherByYear.map((group) => (
          <section class="projects-page__year" aria-label={`${messages.projects.otherProjectsAria} ${group.year}`}>
            <h4>{group.year}</h4>
            <ul>
              {group.projects.map((project) => (
                <li>
                  <a href={project.sourceUrl} target="_blank" rel="noopener noreferrer">
                    <span class="projects-page__name">{project.title}</span>
                    <span class={`projects-page__status projects-page__status--${project.status}`}>{localizedStatus(project.statusLabel)}</span>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>
    )}

    <ClosingCta
      variant="projects"
      prompt={messages.projects.ideaPrompt}
      emphasis={messages.projects.talk}
      href={localizedPagePath(locale, 'contact')}
      ariaLabel={messages.projects.talkAria}
    />
  </main>
</SiteLayout>
