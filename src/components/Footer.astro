---
import { siFacebook, siX, siLinkedin, siInstagram, siGithub, siGoogleplay } from 'simple-icons';

const year = new Date().getFullYear();
---

<footer>
  <section class="content">
    <div class="footer__wrapper">
      <div class="footer__flex">
        <img class="footer__logo" src="/tau.svg" alt="Tau" data-scroll-top />
        <div class="footer__icons">
          <a href="https://www.facebook.com/TauStudioX" aria-label="Facebook"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d={siFacebook.path} /></svg></a>
          <a href="https://twitter.com/TauStudioX" aria-label="Twitter"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d={siX.path} /></svg></a>
          <a href="https://www.linkedin.com/company/tau" aria-label="LinkedIn"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d={siLinkedin.path} /></svg></a>
          <a href="https://www.instagram.com/taustudiox" aria-label="Instagram"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d={siInstagram.path} /></svg></a>
          <a href="https://github.com/tau" aria-label="GitHub"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d={siGithub.path} /></svg></a>
          <a href="https://play.google.com/store/apps/dev?id=4747667721362765016" aria-label="Google Play"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d={siGoogleplay.path} /></svg></a>
        </div>
      </div>
      <div class="footer__flex">
        <div class="mailto"><a href="mailto:hey@tau.studio">hey@tau.studio</a></div>
        <div class="no-select">/</div>
        <div>©{year} Tau Studio</div>
      </div>
    </div>
  </section>
</footer>

<script>
  document.querySelectorAll('[data-scroll-top]').forEach((el) => {
    el.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  });
</script>