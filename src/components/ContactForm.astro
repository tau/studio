---
---
<form name="contacto" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="contact-form" novalidate>
  <input type="hidden" name="form-name" value="contacto" />
  <p class="honeypot">
    <label>No rellenar: <input name="bot-field" /></label>
  </p>

  <div class="contact-form__fields">
    <label class="contact-form__field">
      <span>Nombre</span>
      <input id="contact-name" type="text" name="nombre" autocomplete="name" aria-describedby="error-nombre" required />
      <small id="error-nombre" class="field-error" data-for="nombre"></small>
    </label>

    <label class="contact-form__field">
      <span>Email</span>
      <input id="contact-email" type="email" name="email" autocomplete="email" aria-describedby="error-email" required />
      <small id="error-email" class="field-error" data-for="email"></small>
    </label>

    <label class="contact-form__field">
      <span>Teléfono <small>(opcional)</small></span>
      <input id="contact-phone" type="tel" name="telefono" autocomplete="tel" />
    </label>

    <label class="contact-form__field">
      <span>Servicio de interés</span>
      <select id="contact-service" name="servicio">
        <option value="">Selecciona una opción</option>
        <option value="web">Desarrollo web</option>
        <option value="marketing">Marketing digital</option>
        <option value="seo">SEO</option>
        <option value="otro">Otro</option>
      </select>
    </label>

    <label class="contact-form__field contact-form__field--wide">
      <span>Cuéntanos sobre tu proyecto</span>
      <textarea id="contact-message" name="mensaje" rows="5" aria-describedby="error-mensaje" required></textarea>
      <small id="error-mensaje" class="field-error" data-for="mensaje"></small>
    </label>
  </div>

  <label class="contact-form__consent">
    <input type="checkbox" name="consentimiento" value="aceptado" aria-describedby="error-consentimiento" required />
    <span>Acepto la política de privacidad</span>
    <small id="error-consentimiento" class="field-error" data-for="consentimiento"></small>
  </label>

  <div id="form-status" class="form-status" aria-live="polite"></div>
  <button class="contact-form__submit" type="submit">
    <span>Enviar mensaje</span>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  </button>
</form>

<script>
  const form = document.querySelector('.contact-form');
  const status = document.getElementById('form-status');

  const showError = (name, message) => {
    const el = form?.querySelector(`[data-for="${name}"]`);
    if (el) el.textContent = message;
    const field = form?.querySelector(`[name="${name}"]`);
    if (field) field.setAttribute('aria-invalid', String(Boolean(message)));
  };

  const clearErrors = () => {
    form?.querySelectorAll('.field-error').forEach((el) => (el.textContent = ''));
    form?.querySelectorAll('[aria-invalid="true"]').forEach((field) => field.removeAttribute('aria-invalid'));
  };

  const validate = () => {
    clearErrors();
    let ok = true;

    const nombre = form?.querySelector('[name="nombre"]');
    if (!nombre?.value.trim()) { showError('nombre', 'El nombre es obligatorio.'); ok = false; }

    const email = form?.querySelector('[name="email"]');
    if (!email?.value.trim()) { showError('email', 'El email es obligatorio.'); ok = false; }
    else if (!email.checkValidity()) { showError('email', 'Introduce un email válido.'); ok = false; }

    const mensaje = form?.querySelector('[name="mensaje"]');
    if (!mensaje?.value.trim()) { showError('mensaje', 'El mensaje es obligatorio.'); ok = false; }

    const consent = form?.querySelector('[name="consentimiento"]');
    if (!consent?.checked) { showError('consentimiento', 'Debes aceptar la política de privacidad.'); ok = false; }

    return ok;
  };

  form?.querySelectorAll('input, textarea, select').forEach((field) => {
    field.addEventListener('input', () => {
      const name = field.getAttribute('name');
      if (name) showError(name, '');
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validate()) return;

    const button = form.querySelector('button[type="submit"]');
    if (button) button.disabled = true;
    if (status) status.textContent = 'Enviando...';

    try {
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(form)).toString(),
      });

      if (response.ok) {
        if (status) status.textContent = 'Mensaje enviado correctamente. Te responderemos pronto.';
        form.reset();
        clearErrors();
      } else {
        if (status) status.textContent = 'Ha ocurrido un error. Inténtalo de nuevo.';
      }
    } catch {
      if (status) status.textContent = 'Ha ocurrido un error. Inténtalo de nuevo.';
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>

<style>
  .contact-form {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.6rem;
  }
  .contact-form__fields {
    display: grid;
    align-items: start;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.35rem 1rem;
  }
  .contact-form__field {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    color: #111827;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .contact-form__field > span {
    letter-spacing: inherit;
  }
  .contact-form__field > span small {
    color: #6b7280;
    font-size: 0.8em;
    font-weight: 300;
  }
  .contact-form__field input,
  .contact-form__field textarea,
  .contact-form__field select {
    width: 100%;
    height: 46px;
    min-height: 46px;
    max-height: 46px;
    padding: 0.7rem 0.8rem;
    border: 1px solid rgba(17, 24, 39, 0.14);
    border-radius: 2px;
    background: rgba(249, 250, 251, 0.7);
    color: #111827;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 300;
    letter-spacing: 0;
    line-height: 1.2;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }
  .contact-form__field textarea {
    height: 132px;
    min-height: 132px;
    max-height: 132px;
    padding-top: 0.8rem;
    resize: none;
  }
  .contact-form__field input:focus,
  .contact-form__field textarea:focus,
  .contact-form__field select:focus {
    border-color: #fbaf18;
    outline: none;
    background-color: #fff;
    box-shadow: 0 0 0 2px rgba(251, 175, 24, 0.18);
  }
  .contact-form__field [aria-invalid="true"] {
    border-color: #b42318;
  }
  .contact-form__consent {
    display: grid;
    grid-template-columns: 18px 1fr;
    align-items: start;
    gap: 0.25rem 0.65rem;
    color: #374151;
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .contact-form__consent input {
    appearance: none;
    position: relative;
    width: 16px;
    height: 16px;
    margin: 2px 0 0;
    border: 1px solid rgba(17, 24, 39, 0.28);
    border-radius: 1px;
    background: transparent;
    cursor: pointer;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }
  .contact-form__consent input:checked {
    border-color: #fbaf18;
    background: #fbaf18;
  }
  .contact-form__consent input:checked::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 5px;
    width: 4px;
    height: 8px;
    border: solid #111827;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }
  .contact-form__consent input:focus-visible {
    outline: 2px solid #fbaf18;
    outline-offset: 3px;
  }
  .contact-form__consent .field-error {
    grid-column: 2;
  }
  .contact-form__submit {
    justify-self: start;
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 0.7rem 1rem;
    border: 1px solid #111827;
    border-radius: 2px;
    background: #111827;
    color: #fff;
    font: inherit;
    cursor: pointer;
    transition: background-color 0.3s ease, border-color 0.3s ease,
      color 0.3s ease;
  }
  .contact-form__submit:hover {
    border-color: #fbaf18;
    background: #fbaf18;
    color: #111827;
  }
  .contact-form__submit:focus-visible {
    outline: 2px solid #fbaf18;
    outline-offset: 3px;
  }
  .contact-form__submit:disabled {
    cursor: wait;
    opacity: 0.65;
  }
  .contact-form__submit svg {
    color: #fbaf18;
    transition: transform 0.3s ease, color 0.3s ease;
  }
  .contact-form__submit:hover svg {
    color: #111827;
    transform: translateX(3px);
  }
  .honeypot {
    display: none;
  }
  .form-status {
    min-height: 0;
    margin: 0;
    color: #374151;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .field-error {
    color: #b42318;
    font-size: 0.8rem;
    font-weight: 300;
    min-height: 0;
  }
  .field-error:empty,
  .form-status:empty {
    display: none;
  }
  @media (min-width: 600px) {
    .contact-form__fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .contact-form__field--wide {
      grid-column: 1 / -1;
    }
  }
</style>
