---
interface Props {
  href?: string;
  label?: string;
  class?: string;
}

const {
  href = 'https://tau.studio',
  label = 'Desarrollado por Tau Studio',
  class: className,
} = Astro.props;
---

<a
  class:list={['tau-credit', className]}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
>
  <img src="https://tau.studio/tau.svg" alt="Tau Studio" width="18" height="18" loading="lazy" decoding="async" />
  <span>{label}</span>
</a>

<style>
  .tau-credit {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    color: inherit;
    opacity: 0.65;
    transition: opacity 0.2s ease;
  }
  .tau-credit:hover,
  .tau-credit:focus {
    opacity: 1;
  }
  .tau-credit:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
    border-radius: 4px;
  }
  .tau-credit img {
    display: block;
    width: 18px;
    height: 18px;
    object-fit: contain;
  }
</style>
