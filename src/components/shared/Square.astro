---
interface Props {
  client: { logo: string; task?: string };
}

const { client } = Astro.props;
---

<div class="square">
  <div class="square__wrapper">
    <img class="square__image" src={client.logo} alt="" loading="lazy" decoding="async" />
  </div>
  {client.task && <span class="square__task">{client.task}</span>}
</div>
