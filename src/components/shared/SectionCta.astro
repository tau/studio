---
import Icon from '@/components/shared/Icon.astro';

interface Props {
  variant: 'clients' | 'projects';
  prompt: string;
  label: string;
  href: string;
}

const { variant, prompt, label, href } = Astro.props;
---

<div class={`section-cta section-cta--${variant}`}>
  <span>{prompt}</span>
  <a href={href}>
    <span>{label}</span>
    <Icon name="arrow-right" />
  </a>
</div>
