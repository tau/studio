---
interface Props {
  variant: 'clients' | 'projects';
  prompt: string;
  label: string;
  href: string;
}

const { variant, prompt, label, href } = Astro.props;
---

<div class={`section-cta section-cta--${variant}`}>
  <span>{prompt}</span>
  <a href={href}>
    <span>{label}</span>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  </a>
</div>
