---
interface Props {
  variant: 'services' | 'projects' | 'team';
  prompt: string;
  emphasis: string;
  href?: string;
  ariaLabel: string;
}

const {
  variant,
  prompt,
  emphasis,
  href = '/contacto',
  ariaLabel,
} = Astro.props;
---

<div class={`closing-cta closing-cta--${variant}`}>
  <p>{prompt} <span>{emphasis}</span></p>
  <a href={href} aria-label={ariaLabel}>
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  </a>
</div>
