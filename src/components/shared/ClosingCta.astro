---
import Icon from '@/components/shared/Icon.astro';

interface Props {
  variant: 'services' | 'projects' | 'team';
  prompt: string;
  emphasis: string;
  href?: string;
  ariaLabel: string;
}

const {
  variant,
  prompt,
  emphasis,
  href = '/contacto',
  ariaLabel,
} = Astro.props;
---

<div class={`closing-cta closing-cta--${variant}`}>
  <p>{prompt} <span>{emphasis}</span></p>
  <a href={href} aria-label={ariaLabel}>
    <Icon name="arrow-right" size={20} />
  </a>
</div>
