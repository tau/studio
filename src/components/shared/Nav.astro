---
import { getMessages } from '@/i18n/messages';
import { asLocale, locales, localeNames, localizedPagePath, localizedPathForLocale, type Locale } from '@/i18n/routing';

interface Props { locale?: Locale }
const locale = asLocale(Astro.props.locale ?? Astro.currentLocale ?? undefined);
const messages = getMessages(locale);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const items = [
  { page: 'services' as const, className: 'c1', label: messages.navigation.services },
  { page: 'projects' as const, className: 'c2', label: messages.navigation.projects },
  { page: 'team' as const, className: 'c3', label: messages.navigation.team },
  { page: 'contact' as const, className: 'c4', label: messages.navigation.contact },
].map((item) => ({ ...item, href: localizedPagePath(locale, item.page) }));
const currentItem = items.find((item) => currentPath === item.href || currentPath.startsWith(`${item.href}/`));
const menuAccentByClass: Record<string, string> = {
  c1: '#6853A2',
  c2: '#EC1978',
  c3: '#5ABE93',
  c4: '#FBAF18',
};
const menuAccent = currentItem
  ? menuAccentByClass[currentItem.className]
  : 'var(--home-hero-accent, #111827)';
---

<nav class="site-nav" id="top" aria-label={messages.navigation.ariaLabel}>
  <section class="content">
    <div class="nav__wrapper">
        <a class="nav__logo-wrapper" href={localizedPagePath(locale, 'home')} aria-label={messages.navigation.homeLabel}>
        <img class="nav__logo" src="/tau.svg" alt="" />
        <img class="nav__name" src="/studio.svg" alt="" />
      </a>

      <button class="menu__btn" id="menu-btn" type="button" aria-label={messages.navigation.menuOpen} data-open-label={messages.navigation.menuOpen} data-close-label={messages.navigation.menuClose} aria-controls="nav-flex" aria-expanded="false" style={`--menu-accent: ${menuAccent}`}>
        <svg class="icon-menu" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg class="icon-close" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" style="display:none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>

      <div class="nav__flex" id="nav-flex" data-menu-label={messages.navigation.menuHeading}>
        <ul class="nav__items">
          {items.map((item) => (
              <li class={`${item.className}${currentItem === item ? ' is-current' : ''}`}>
                <a href={item.href} aria-current={currentItem === item ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
          <div class="nav__languages" aria-label={messages.navigation.language}>
            {locales.map((targetLocale) => (
              <a href={localizedPathForLocale(Astro.url.pathname, targetLocale)} lang={targetLocale} aria-current={locale === targetLocale ? 'page' : undefined} aria-label={localeNames[targetLocale]}>
                {targetLocale.toUpperCase()}
              </a>
            ))}
          </div>
        </div>
    </div>
  </section>
</nav>

<script>
  const btn = document.getElementById('menu-btn');
  const flex = document.getElementById('nav-flex');
  const menuIcon = btn?.querySelector('.icon-menu');
  const closeIcon = btn?.querySelector('.icon-close');
  const openLabel = btn?.getAttribute('data-open-label') ?? 'Open menu';
  const closeLabel = btn?.getAttribute('data-close-label') ?? 'Close menu';
  let open = false;

  const setOpen = (value: boolean) => {
    open = value;
    flex?.classList.toggle('show', open);
    if (menuIcon && closeIcon) {
      (menuIcon as HTMLElement).style.display = open ? 'none' : 'block';
      (closeIcon as HTMLElement).style.display = open ? 'block' : 'none';
    }
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? closeLabel : openLabel);
    document.body.style.overflow = open ? 'hidden' : '';
  };

  btn?.addEventListener('click', () => setOpen(!open));
  flex?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && open) {
      setOpen(false);
      btn?.focus();
    }
  });
</script>
