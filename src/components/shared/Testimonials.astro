---
import { Image } from 'astro:assets';
import type { Testimonial } from '@/data/testimonials';
import { getMessages } from '@/i18n/messages';
import { asLocale, type Locale } from '@/i18n/routing';

interface Props {
  testimonials: Testimonial[];
  locale?: Locale;
}

const { testimonials } = Astro.props;
const locale = asLocale(Astro.props.locale ?? Astro.currentLocale ?? undefined);
const messages = getMessages(locale);
---

{testimonials.length > 0 && (
  <section class="testimonials-section" aria-labelledby="testimonials-title">
    <h3 class="testimonials__title" id="testimonials-title">{messages.testimonials.heading}</h3>
    <div class="testimonials__grid">
      {testimonials.map((testimonial) => (
        <figure class="testimonials__card">
          <blockquote lang={testimonial.quoteLocale}><p>{testimonial.quote}</p></blockquote>
          <figcaption>
            {testimonial.logo && <Image class="testimonials__logo" src={testimonial.logo} alt="" loading="lazy" decoding="async" />}
            <span class="testimonials__identity">
              <strong>{testimonial.name}</strong>
              {(testimonial.role || testimonial.company) && (
                <span>{[testimonial.role, testimonial.company].filter(Boolean).join(' · ')}</span>
              )}
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}
