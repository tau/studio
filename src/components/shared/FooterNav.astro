---
const items = [
  { href: '/servicios', cls: 'c1', number: '01', label: 'Servicios', text: 'Diseño, desarrollo y crecimiento digital para tu marca.' },
  { href: '/proyectos', cls: 'c2', number: '02', label: 'Proyectos', text: 'Ideas y colaboraciones llevadas a la práctica.' },
  { href: '/equipo', cls: 'c3', number: '03', label: 'El equipo', text: 'Conoce cómo pensamos, diseñamos y trabajamos.' },
  { href: '/contacto', cls: 'c4', number: '04', label: 'Contacto', text: 'Cuéntanos qué tienes en mente. Hablemos.' },
];
---

<nav class="footer-nav" aria-label="Explora Tau Studio">
  <section class="content">
    <section class="footer-nav__wrapper">
      <div class="footer-nav__heading">
        <p>Continúa explorando</p>
        <span class="footer-nav__rule" aria-hidden="true"></span>
      </div>
      <div class="footer-nav__flex">
        {items.map((item) => (
          <a href={item.href} class={`footer-nav__item ${item.cls}`}>
            <span class="footer-nav__number">{item.number}</span>
            <span class="footer-nav__copy">
              <strong>{item.label}</strong>
              <span>{item.text}</span>
            </span>
            <svg class="footer-nav__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        ))}
      </div>
    </section>
  </section>
</nav>
