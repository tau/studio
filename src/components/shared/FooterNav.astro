---
import { getMessages } from '@/i18n/messages';
import { asLocale, localizedPagePath, type Locale } from '@/i18n/routing';

interface Props { locale?: Locale }
const locale = asLocale(Astro.props.locale ?? Astro.currentLocale ?? undefined);
const messages = getMessages(locale);
const items = [
  { page: 'services' as const, cls: 'c1', number: '01', label: messages.navigation.services, text: messages.footer.nav.servicesText },
  { page: 'projects' as const, cls: 'c2', number: '02', label: messages.navigation.projects, text: messages.footer.nav.projectsText },
  { page: 'team' as const, cls: 'c3', number: '03', label: messages.navigation.team, text: messages.footer.nav.teamText },
  { page: 'contact' as const, cls: 'c4', number: '04', label: messages.navigation.contact, text: messages.footer.nav.contactText },
].map((item) => ({ ...item, href: localizedPagePath(locale, item.page) }));
---

<nav class="footer-nav" aria-label={messages.navigation.footerAriaLabel}>
  <section class="content">
    <section class="footer-nav__wrapper">
      <div class="footer-nav__heading">
          <p>{messages.footer.navHeading}</p>
        <span class="footer-nav__rule" aria-hidden="true"></span>
      </div>
      <div class="footer-nav__flex">
        {items.map((item) => (
          <a href={item.href} class={`footer-nav__item ${item.cls}`}>
            <span class="footer-nav__number">{item.number}</span>
            <span class="footer-nav__copy">
              <strong>{item.label}</strong>
              <span>{item.text}</span>
            </span>
            <svg class="footer-nav__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        ))}
      </div>
    </section>
  </section>
</nav>
