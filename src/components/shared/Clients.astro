---
import Square from '@/components/shared/Square.astro';
import SectionCta from '@/components/shared/SectionCta.astro';

interface Props {
  clients?: any[];
  max?: number;
  total?: number;
  projectTotal?: number;
}

const { clients = [], max, total, projectTotal } = Astro.props;
const limit = max ?? 14;
const featuredClients = clients.slice(0, limit);
const totalClientCount = String(total ?? clients.length).padStart(2, '0');
---

<section id="clients" class="clients-section" aria-labelledby="clients-title">
  <div class="content">
    <div class="clients__intro">
      <div class="clients__heading">
        <p class="clients__eyebrow"><span></span> Clientes <b># {totalClientCount}</b></p>
        <h2 id="clients-title">Clientes que confían <em>en Tau Studio.</em></h2>
      </div>
      <div class="clients__summary">
        <p>Trabajamos junto a equipos que quieren hacer crecer su presencia digital con ideas claras y soluciones bien construidas.</p>
        <div class="clients__count">
          <div class="clients__count-item">
            <strong>{totalClientCount}</strong>
            <span>clientes</span>
          </div>
          <div class="clients__count-item">
            <strong>{projectTotal ?? '—'}</strong>
            <span>proyectos</span>
          </div>
        </div>
      </div>
    </div>

    <div class="clients__carousel" aria-label="Clientes de Tau Studio">
      <div class="clients__track">
        {featuredClients.map((client) => (
          <Square client={client} />
        ))}
        {featuredClients.map((client) => (
          <Square client={client} />
        ))}
      </div>
    </div>

    <SectionCta
      variant="clients"
      prompt="¿Hacemos equipo?"
      label="Cuéntanos tu proyecto"
      href="/contacto"
    />
  </div>
</section>
