---
interface Props {
  name: 'arrow-right' | 'external-link';
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 18, strokeWidth = 1.8, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width={strokeWidth} aria-hidden="true">
  {name === 'arrow-right'
    ? <path d="M5 12h14M13 6l6 6-6 6" />
    : <path d="M7 17 17 7M7 7h10v10" />}
</svg>
