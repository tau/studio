---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/Nav.astro';
import FooterNav from '@/components/FooterNav.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const { title, description, robots } = Astro.props;
---

<BaseLayout title={title} description={description} robots={robots}>
  <Nav />
  <section id="main">
    <slot />
  </section>
  <FooterNav />
  <Footer />
</BaseLayout>